# ============================
# Savanna Finance — Deployment
# ============================
# Copy this file to .env and fill in your values

# Wallet private key (NEVER share or commit this!)
DEPLOYER_PRIVATE_KEY=your_private_key_here

# Celo RPC Endpoints
# Mainnet: https://forno.celo.org
# Sepolia: https://forno.celo-sepolia.celo-testnet.org

# Etherscan / Celoscan API Key (for contract verification)
# Get yours at: https://celoscan.io/myapikey or https://etherscan.io/myapikey
CELOSCAN_API_KEY=your_celoscan_api_key_here

# ============================
# Chainlink Functions
# ============================
# Create subscription at: https://functions.chain.link
# Fund with LINK token before deploying

# Subscription ID from Chainlink Functions dashboard
CHAINLINK_SUBSCRIPTION_ID=0

# Router address (auto-selected by network, override here if needed)
# Celo Alfajores Testnet: 0xA9d587a00A31A52Ed70D6026794a8FC5E2F5dCb0
# Celo Mainnet:           0xb83E47C2bC239B3bf370bc41e1459A34b41238D0
CHAINLINK_ROUTER_CELO=0xA9d587a00A31A52Ed70D6026794a8FC5E2F5dCb0

# LINK Token on Celo Alfajores: 0x0b9d5D9136855f6FEc3c0993feE6E9CE8a297846
LINK_TOKEN_CELO=0x0b9d5D9136855f6FEc3c0993feE6E9CE8a297846

# DON ID
# Celo Alfajores: fun-celo-alfajores-1
# Celo Mainnet:   fun-celo-mainnet-1
CHAINLINK_DON_ID=fun-celo-alfajores-1

# ============================
# Deployed Contract Addresses
# ============================
# Fill after deploying vault + controller
CONTROLLER_ADDRESS=
VAULT_ADDRESS=
